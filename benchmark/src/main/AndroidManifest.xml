<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      **不要在这里声明 WRITE_EXTERNAL_STORAGE**。
      API 33+ 起它已经不是可授予的运行时权限，AndroidJUnitRunner 启动时会尝试授权、
      失败后把全部用例判成 `Failed to grant permissions`（第一次跑就踩了这个）。
      新版 Macrobenchmark 把 perfetto trace 写到 additionalTestOutputDir，
      本来也不需要外部存储权限。
    -->

    <!-- targetSdk 30+ 的包可见性限制：要能枚举被测 App 的包 -->
    <queries>
        <package android:name="com.myapp" />
    </queries>

</manifest>
